  "authors": [
    "K3 Operations Team"
  ],
  "contact": {
    "homepage": "https://github.com/Fandry96/k3-diegetic",
    "sources": "https://github.com/Fandry96/k3-diegetic",
    "issues": "https://github.com/Fandry96/k3-diegetic/issues"
  },
  "license": "MIT",
  "icon": "assets/k3_diegetic/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.k3.diegetic.K3DiegeticMod"
    ],
    "client": [
      "com.k3.diegetic.client.K3DiegeticClient"
    ],
    "fabric-datagen": [
      "com.k3.diegetic.data.K3DiegeticDataGenerator"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
